{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-forum",
      "schedule": "0 8,20 * * *"
    },
    {
      "path": "/api/cron-chronicle",
      "schedule": "0 10 * * 1,4"
    }
  ]
}
